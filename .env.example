# Ton token Discord (NE JAMAIS PARTAGER)
# Pour le trouver : Discord > DevTools (F12) > Network > chercher "api" > Headers > Authorization
DISCORD_TOKEN=ton_token_ici

# IDs des serveurs a surveiller (separes par des virgules)
# Clique droit sur le serveur > Copier l'identifiant du serveur
GUILD_IDS=123456789012345678

# Dossier pour sauvegarder les images telechargees
IMAGES_DIR=./data/images

# Fichier de la base de donnees SQLite
DATABASE_PATH=./data/cryptobot.db
